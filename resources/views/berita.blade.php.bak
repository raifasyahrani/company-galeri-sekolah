    <script>
        const buttons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.berita-card');
        const emptyState = document.getElementById('empty-state');
        const resultCount = document.getElementById('result-count');
        const resetBtn = document.getElementById('reset-filter');

        let activeFilter = 'Semua';

        const setActiveButton = (btn) => {
            buttons.forEach(b => {
                b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');
                b.classList.add('bg-white', 'text-gray-500', 'border-gray-200');
                const c = b.querySelector('.filter-count');
                c.classList.remove('bg-white/20');
                c.classList.add('bg-gray-100');
            });
            btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');
            btn.classList.remove('bg-white', 'text-gray-500', 'border-gray-200');
            const c = btn.querySelector('.filter-count');
            c.classList.add('bg-white/20');
            c.classList.remove('bg-gray-100');
        };

        // Terapkan filter kategori
        const applyFilter = () => {
            let visibleCount = 0;

            cards.forEach(card => {
                const show = activeFilter === 'Semua' || card.dataset.kategori === activeFilter;
                card.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            emptyState.classList.toggle('hidden', visibleCount > 0);
            resultCount.textContent = 'Menampilkan ' + visibleCount + ' berita';
        };

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                activeFilter = btn.dataset.filter;
                setActiveButton(btn);
                applyFilter();
            });
        });

        resetBtn.addEventListener('click', () => {
            document.querySelector('.filter-btn[data-filter="Semua"]').click();
        });

        applyFilter();

        // Jika datang dari anchor link (mis. dari Beranda: /berita#slug-berita),
        // pastikan filter "Semua" aktif dulu supaya berita tujuan tidak ikut ter-hidden,
        // lalu browser akan auto-scroll ke elemen dengan id tersebut.
        if (window.location.hash) {
            const semuaBtn = document.querySelector('.filter-btn[data-filter="Semua"]');
            if (semuaBtn) semuaBtn.click();
            const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
            if (target) target.scrollIntoView();
        }
    </script>

</body>
</html>