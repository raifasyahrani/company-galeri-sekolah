namespace App\Http\Controllers;

use App\Models\Ekskul;

class AdminEkskulController extends AdminCrudController
{
    protected function cfg(): array
    {
        return [
            'model' => Ekskul::class, 'title' => 'Ekskul', 'subtitle' => 'Kelola ekstrakurikuler yang tampil di halaman publik',
            'route' => 'admin.ekskul', 'folder' => 'ekskul', 'order' => ['id', 'asc'],
            'columns' => [
                ['name' => 'foto', 'label' => 'Foto', 'type' => 'image'],
                ['name' => 'nama', 'label' => 'Nama'],
                ['name' => 'ketua', 'label' => 'Ketua'],
                ['name' => 'pembina', 'label' => 'Pembina'],
                ['name' => 'anggota', 'label' => 'Anggota'],
            ],
            'fields' => [
                ['name' => 'nama', 'label' => 'Nama Ekskul', 'type' => 'text', 'rules' => 'required|string|max:255'],
                ['name' => 'deskripsi', 'label' => 'Deskripsi', 'type' => 'textarea', 'rows' => 5, 'rules' => 'required|string'],
                ['name' => 'ketua', 'label' => 'Ketua Ekskul', 'type' => 'text', 'rules' => 'nullable|string|max:255'],
                ['name' => 'pembina', 'label' => 'Pembina', 'type' => 'text', 'rules' => 'nullable|string|max:255'],
                ['name' => 'jadwal', 'label' => 'Hari Latihan', 'type' => 'text', 'placeholder' => 'contoh: Rabu & Sabtu', 'rules' => 'nullable|string|max:100'],
                ['name' => 'jam', 'label' => 'Jam Latihan', 'type' => 'text', 'placeholder' => 'contoh: 15.00 - 17.00 WIB', 'rules' => 'nullable|string|max:100'],
                ['name' => 'anggota', 'label' => 'Jumlah Anggota', 'type' => 'text', 'rules' => 'nullable|integer|min:0'],
                ['name' => 'foto', 'label' => 'Foto Sampul (maks 2 MB)', 'type' => 'image', 'rules' => 'nullable|image|max:2048'],
                ['name' => 'logo', 'label' => 'Logo (maks 2 MB)', 'type' => 'image', 'rules' => 'nullable|image|max:2048'],
            ],
        ];
    }
}