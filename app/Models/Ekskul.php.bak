<?php

namespace App\Models;

use Carbon\Carbon;
use Illuminate\Database\Eloquent\Model;

class Ekskul extends Model
{
    protected $table = 'ekskuls';

    protected $fillable = [
        'nama', 'deskripsi', 'pembina', 'ketua', 'jumlah_anggota',
        'hari_latihan', 'jam_latihan', 'gambar', 'foto_sampul', 'urutan',
    ];

    public const HARI = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];

    // Path berawalan "images/" = file bawaan di public/images, selain itu = storage
    private static function urlGambar(?string $path): ?string
    {
        if (!$path) {
            return null;
        }
        $path = str_starts_with($path, 'images/') ? $path : 'storage/' . $path;

        return asset(implode('/', array_map('rawurlencode', explode('/', $path))));
    }

    public function getLogoUrlAttribute(): ?string
    {
        return self::urlGambar($this->gambar);
    }

    public function getSampulUrlAttribute(): ?string
    {
        return self::urlGambar($this->foto_sampul);
    }

    // "Rabu,Sabtu" -> ['Rabu','Sabtu'] (urut Senin..Minggu)
    public function getHariListAttribute(): array
    {
        $list = array_filter(array_map('trim', explode(',', (string) $this->hari_latihan)));

        return array_values(array_intersect(self::HARI, $list));
    }

    // "Jumat" / "Rabu & Sabtu" / "Senin - Sabtu"
    public function getJadwalTeksAttribute(): string
    {
        $h = $this->hari_list;

        return match (true) {
            count($h) === 0 => '-',
            count($h) === 1 => $h[0],
            count($h) === 2 => $h[0] . ' & ' . $h[1],
            default         => $h[0] . ' - ' . end($h),
        };
    }

    public function getLatihanHariIniAttribute(): bool
    {
        $hari = Carbon::now('Asia/Jakarta')->locale('id')->isoFormat('dddd');

        return in_array($hari, $this->hari_list, true);
    }

    // ---------- DATA AWAL (10 ekskul dari halaman depan) ----------

    public static function isiDataAwalJikaKosong(): void
    {
        if (static::query()->count() === 0) {
            static::isiDataAwal();
        }
    }

    // Mengembalikan jumlah ekskul yang dimasukkan. Yang sudah ada (nama sama) dilewati.
    public static function isiDataAwal(): int
    {
        $data = [
            ['Pramuka', 'LOGO PRAMUKA.png', 'pramuka ekskul.jpeg', 'Satria Budhiyana (XII TO 1)', 'Ibu Sri Esti, S.Pd.', 'Jumat', '15.00 - 17.00 WIB', 75,
                'Melatih kemandirian, kepemimpinan, dan kepedulian sosial siswa melalui kegiatan kepramukaan, mulai dari baris-berbaris, tali-temali, hingga kegiatan perkemahan.'],
            ['Paskibra', 'LOGO PASKIB.png', 'paskib ekskul.JPG', 'Muhammad Faturahman (XII TJKT 2)', 'Bapak Sunggono, S.Pd.', 'Rabu,Sabtu', '15.00 - 17.00 WIB', 50,
                'Membina kedisiplinan dan kekompakan siswa melalui latihan baris-berbaris serta bertugas sebagai pengibar bendera pada upacara resmi sekolah.'],
            ['PMR', 'LOGO PMR.png', 'pmr ekskul.jpeg', 'Mawar Khaeriza Destri (XII PPLG 1)', 'Ibu Ruri Marlinawati, S.Pd.', 'Kamis', '14.00 - 16.00 WIB', 45,
                'Melatih siswa dalam pertolongan pertama pada kecelakaan (P3K), kepedulian kesehatan, dan siap menjadi relawan pada kegiatan sekolah.'],
            ['Basket', 'LOGO BASKET.png', 'basket ekskul.JPG', 'Fajar Ramadhan (XII TJKT 2)', 'Bapak Ade Eka Sastra, S.Pd.', 'Selasa', '15.30 - 17.00 WIB', 20,
                'Mengembangkan kemampuan teknik dan strategi bermain basket, aktif mengikuti berbagai turnamen antar sekolah tingkat kota maupun provinsi.'],
            ['Futsal', 'LOGO FUTSAL.png', 'futsal1.jpg', 'Nando (XII TPFL 2)', 'Bapak Ade Eka Sastra, S.Pd.', 'Senin,Kamis', '15.00 - 17.30 WIB', 25,
                'Tim futsal sekolah yang rutin berlatih dan mengikuti kompetisi antar sekolah, salah satu prestasinya adalah Juara 3 IBG Championship Festival 2026.'],
            ['Pencak Silat', 'logo silat.png', 'silat ekskul.jpeg', 'Melati (XII TJKT 1)', 'Bapak Ade Eka Sastra, S.Pd.', 'Rabu,Sabtu', '15.00 - 16.30 WIB', 18,
                'Melestarikan budaya bela diri asli Indonesia sekaligus melatih fisik, mental, dan sportivitas siswa. Meraih Juara 1 Regu Putri pada kejuaraan pencak silat tingkat kota.'],
            ['Band', 'logo band.png', 'band ekskul.jpg', 'Thariq (XII TPFL 1)', 'Bapak Tri Wahyono, S.Pd.', 'Rabu', '15.00 - 17.30 WIB', 15,
                'Menyalurkan minat siswa di bidang musik, tampil pada berbagai acara sekolah seperti perpisahan, MPLS, dan Pensi.'],
            ['Paduan Suara', 'logo padus.png', 'paduss.png', 'Keisha (XII PPLG 1)', 'Ibu Tresna Septiarti Amalia, S.Pd.', 'Kamis', '15.00 - 16.30 WIB', 22,
                'Bertugas mengisi paduan suara pada upacara bendera dan acara resmi sekolah, perpisahan, sekaligus melatih vokal dan kekompakan bernyanyi bersama.'],
            ['Tari', 'logo tari.png', 'tarii.jpeg', 'Raifa Hasna Syahrani (XII PPLG 2)', 'Ibu Vivi Safitri Desemberiyani, S.Pd.', 'Sabtu', '09.00 - 11.00 WIB', 20,
                'Melestarikan seni tari tradisional dan modern, sering tampil mewakili sekolah pada acara budaya dan perayaan hari besar.'],
            ['Rohis', 'logo rohis.png', 'rohis ekskul.jpg', 'M Davi (XII PPLG 1)', 'Bapak S, S.Pd.', 'Senin,Selasa,Rabu,Kamis,Jumat,Sabtu', '06.00 - 08.00 WIB', 20,
                'Ekstrakurikuler sekolah untuk memperdalam ilmu agama Islam, memperkuat keimanan, dan membentuk akhlak mulia siswa melalui kegiatan kajian, mentoring, serta penguatan karakter Islami yang toleran dan mandiri (kajian rutin, tahsin/tahfidz, peringatan hari besar Islam, dll).'],
        ];

        $masuk = 0;

        foreach ($data as $i => [$nama, $logo, $sampul, $ketua, $pembina, $hari, $jam, $anggota, $deskripsi]) {
            if (static::where('nama', $nama)->exists()) {
                continue;
            }

            static::create([
                'nama'           => $nama,
                'gambar'         => 'images/' . $logo,
                'foto_sampul'    => 'images/' . $sampul,
                'ketua'          => $ketua,
                'pembina'        => $pembina,
                'hari_latihan'   => $hari,
                'jam_latihan'    => $jam,
                'jumlah_anggota' => $anggota,
                'deskripsi'      => $deskripsi,
                'urutan'         => $i + 1,
            ]);
            $masuk++;
        }

        return $masuk;
    }
}